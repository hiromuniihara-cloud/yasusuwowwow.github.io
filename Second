<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>楽曲ソート</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f3f6fb; --ink:#14213d; --sub:#5b6785; --line:#d5dcec;
  --blue:#2a3bd6; --blue-soft:#e4e8fc; --pink:#f0457a; --pink-soft:#fde5ee; --card:#fff;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:"Zen Maru Gothic","Hiragino Maru Gothic ProN","Hiragino Sans",sans-serif;line-height:1.6;padding:20px 16px 60px;max-width:560px;margin:0 auto}
h1{font-size:26px;font-weight:900;margin:8px 0 4px;letter-spacing:.02em}
h2{font-size:16px;margin:28px 0 8px}
p.lead{color:var(--sub);margin:0 0 16px;font-size:14px}
.hidden{display:none!important}
button{font:inherit;color:inherit;cursor:pointer}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:2px solid var(--line);background:var(--card);border-radius:999px;padding:6px 14px;font-weight:700;font-size:14px}
.chip.on{border-color:var(--blue);background:var(--blue-soft);color:var(--blue)}
.songs{display:flex;flex-direction:column;gap:6px;max-height:46vh;overflow-y:auto;padding:2px;border-top:1px solid var(--line);padding-top:10px}
.song{display:flex;justify-content:space-between;gap:10px;align-items:center;text-align:left;border:2px solid var(--line);background:var(--card);border-radius:12px;padding:10px 12px;font-size:15px}
.song small{color:var(--sub);font-size:12px;white-space:nowrap}
.song.on{border-color:var(--blue);background:var(--blue-soft)}
.row{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}
.mini{border:none;background:none;color:var(--blue);font-weight:700;font-size:14px;padding:4px 2px;text-decoration:underline}
.bar{position:sticky;bottom:0;background:linear-gradient(transparent,var(--bg) 30%);padding:18px 0 8px;margin-top:8px;display:flex;align-items:center;gap:12px}
.bar span{font-weight:700;flex:1}
.primary{background:var(--blue);color:#fff;border:none;border-radius:14px;padding:14px 22px;font-weight:900;font-size:16px}
.primary:disabled{background:#aab1d8;cursor:not-allowed}
.ghost{background:var(--card);border:2px solid var(--line);border-radius:14px;padding:10px 16px;font-weight:700}
.resume{background:var(--pink-soft);border:2px solid var(--pink);border-radius:14px;padding:14px;margin-bottom:18px}
.resume b{display:block;margin-bottom:8px}
/* battle */
.progress{height:8px;background:var(--line);border-radius:99px;overflow:hidden;margin:8px 0 4px}
.progress i{display:block;height:100%;background:var(--blue);width:0;transition:width .2s}
.count{color:var(--sub);font-size:13px;text-align:right;margin:0 0 14px}
.q{text-align:center;font-weight:900;font-size:20px;margin:6px 0 16px}
.pick{display:block;width:100%;text-align:center;border:none;border-radius:18px;padding:34px 16px;font-size:20px;font-weight:900;line-height:1.4}
.pick small{display:block;font-size:12px;font-weight:700;opacity:.7;margin-bottom:6px}
.pick.a{background:var(--blue-soft);color:var(--blue)}
.pick.b{background:var(--pink-soft);color:var(--pink)}
.pick:active{transform:scale(.98)}
.vs{text-align:center;font-weight:900;color:var(--sub);margin:10px 0}
.tie{display:block;width:100%;margin-top:14px;border:2px dashed var(--line);background:none;border-radius:14px;padding:12px;font-weight:700;color:var(--sub)}
/* result */
ol.rank{list-style:none;margin:16px 0;padding:0;display:flex;flex-direction:column;gap:8px}
ol.rank li{display:flex;gap:14px;align-items:center;background:var(--card);border-radius:14px;padding:12px 14px;border:2px solid var(--line)}
ol.rank li:nth-child(1){border-color:var(--pink);background:var(--pink-soft)}
.no{font-weight:900;font-size:22px;min-width:34px;text-align:center;color:var(--blue)}
li:nth-child(1) .no{color:var(--pink)}
.tt{font-weight:700}
.tt small{display:block;color:var(--sub);font-weight:500;font-size:12px}
footer{margin-top:40px;font-size:12px;color:var(--sub)}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<!-- ============ 設定画面 ============ -->
<section id="setup">
  <h1>楽曲ソート</h1>
  <p class="lead">好きな曲を2択で選び続けて、自分だけのランキングを作ろう。</p>

  <div id="resume" class="resume hidden">
    <b>前回のソートが途中です</b>
    <div class="row">
      <button class="primary" id="btnResume">続きから再開</button>
      <button class="ghost" id="btnDiscard">最初からやる</button>
    </div>
  </div>

  <h2>1. グループを選ぶ</h2>
  <div class="chips" id="groupChips"></div>

  <h2>2. 何位まで決める？</h2>
  <div class="chips" id="topChips"></div>

  <h2>3. ソートする曲をタップで選ぶ</h2>
  <div class="row">
    <button class="mini" id="allOn">表示中を全部選ぶ</button>
    <button class="mini" id="allOff">表示中を全部外す</button>
  </div>
  <div class="songs" id="songList"></div>

  <div class="bar">
    <span id="selCount">選択中 0曲</span>
    <button class="primary" id="btnStart" disabled>ソート開始</button>
  </div>
</section>

<!-- ============ バトル画面 ============ -->
<section id="battle" class="hidden">
  <div class="progress"><i id="progBar"></i></div>
  <p class="count" id="progText"></p>
  <p class="q">どっちの曲が好き？</p>
  <button class="pick a" id="pickA"></button>
  <div class="vs">VS</div>
  <button class="pick b" id="pickB"></button>
  <button class="tie" id="btnTie">どっちも同じくらい好き（引き分け）</button>
  <div class="row" style="margin-top:18px;justify-content:space-between">
    <button class="ghost" id="btnUndo">ひとつ戻る</button>
    <button class="ghost" id="btnQuit">中断する</button>
  </div>
</section>

<!-- ============ 結果画面 ============ -->
<section id="result" class="hidden">
  <h1 id="resTitle">あなたの好きな曲ランキング</h1>
  <ol class="rank" id="rankList"></ol>
  <div class="row">
    <a class="primary" id="btnShare" target="_blank" rel="noopener" style="text-decoration:none;display:inline-block">𝕏 に投稿する</a>
    <button class="ghost" id="btnAgain">最初からやり直す</button>
  </div>
</section>

<footer>※このサイトはファンが個人で制作した非公式サイトです。各グループおよび運営会社とは一切関係ありません。</footer>

<script>
/* =====================================================
   曲データ（ここを書き換えて自分の好きな曲リストにしてください）
   g: グループ名 / t: 曲名
   ※下はサンプルです。自由に追加・削除できます。
   ===================================================== */
const SONGS = [
  {g:'AKB48', t:'恋するフォーチュンクッキー'},
  {g:'AKB48', t:'ヘビーローテーション'},
  {g:'AKB48', t:'365日の紙飛行機'},
  {g:'AKB48', t:'会いたかった'},
  {g:'AKB48', t:'大声ダイヤモンド'},
  {g:'AKB48', t:'フライングゲット'},
  {g:'SKE48', t:'オキドキ'},
  {g:'SKE48', t:'パレオはエメラルド'},
  {g:'NMB48', t:'カモネギックス'},
  {g:'NMB48', t:'青春のラップタイム'},
  {g:'HKT48', t:'スキ！スキ！スキップ！'},
  {g:'NGT48', t:'青春時計'},
  {g:'STU48', t:'暗闇'}
].map((s,i)=>({...s,id:i}));

/* ================= 以下はプログラム本体 ================= */
const KEY = 'song-sort-v1';
const $ = id => document.getElementById(id);
const groups = [...new Set(SONGS.map(s=>s.g))];
const activeGroups = new Set(groups);
const selected = new Set(SONGS.map(s=>s.id));
let topN = 10;
let state = null; // {order:[id], answers:[0|1|2], topN}

function show(name){
  ['setup','battle','result'].forEach(n=>$(n).classList.toggle('hidden', n!==name));
  window.scrollTo(0,0);
}
function save(){ try{ localStorage.setItem(KEY, JSON.stringify(state)); }catch(e){} }
function load(){ try{ return JSON.parse(localStorage.getItem(KEY)); }catch(e){ return null; } }
function clearSave(){ try{ localStorage.removeItem(KEY); }catch(e){} }
function shuffle(a){ a=a.slice(); for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; }

/* ---------- 設定画面 ---------- */
function chip(label, on, fn){
  const b=document.createElement('button'); b.className='chip'+(on?' on':''); b.textContent=label; b.onclick=fn; return b;
}
function renderGroups(){
  const box=$('groupChips'); box.innerHTML='';
  groups.forEach(g=>{
    box.appendChild(chip(g, activeGroups.has(g), ()=>{
      const ids=SONGS.filter(s=>s.g===g).map(s=>s.id);
      if(activeGroups.has(g)){ activeGroups.delete(g); ids.forEach(i=>selected.delete(i)); }
      else { activeGroups.add(g); ids.forEach(i=>selected.add(i)); }
      renderAll();
    }));
  });
}
function renderTop(){
  const box=$('topChips'); box.innerHTML='';
  [5,10,16].forEach(n=>box.appendChild(chip('TOP'+n, topN===n, ()=>{ topN=n; renderTop(); })));
}
function renderSongs(){
  const box=$('songList'); box.innerHTML='';
  SONGS.filter(s=>activeGroups.has(s.g)).forEach(s=>{
    const b=document.createElement('button');
    b.className='song'+(selected.has(s.id)?' on':'');
    const t=document.createElement('span'); t.textContent=s.t;
    const g=document.createElement('small'); g.textContent=s.g;
    b.append(t,g);
    b.onclick=()=>{ selected.has(s.id)?selected.delete(s.id):selected.add(s.id); renderSongs(); renderCount(); };
    box.appendChild(b);
  });
}
function renderCount(){
  const n=selected.size;
  $('selCount').textContent='選択中 '+n+'曲';
  $('btnStart').disabled = n<2;
}
function renderAll(){ renderGroups(); renderTop(); renderSongs(); renderCount(); }

$('allOn').onclick=()=>{ SONGS.filter(s=>activeGroups.has(s.g)).forEach(s=>selected.add(s.id)); renderSongs(); renderCount(); };
$('allOff').onclick=()=>{ SONGS.filter(s=>activeGroups.has(s.g)).forEach(s=>selected.delete(s.id)); renderSongs(); renderCount(); };
$('btnStart').onclick=()=>{
  state={order:shuffle([...selected]), answers:[], topN:Math.min(topN, selected.size)};
  save(); renderBattle();
};

/* ---------- ソート本体（マージソート＋引き分け対応） ----------
   answers を先頭から順に消費して再現する方式。
   「ひとつ戻る」は answers の末尾を消すだけでOK。 */
function run(order, answers){
  let k=0;
  let lists=order.map(id=>[[id]]); // 各要素は「同順位グループ」の配列
  while(lists.length>1){
    const next=[];
    for(let p=0;p<lists.length;p+=2){
      if(p+1>=lists.length){ next.push(lists[p]); continue; }
      const A=lists[p], B=lists[p+1], out=[];
      let i=0, j=0;
      while(i<A.length && j<B.length){
        if(k>=answers.length) return {done:false, pair:[A[i],B[j]]};
        const a=answers[k++];
        if(a===0) out.push(A[i++]);
        else if(a===1) out.push(B[j++]);
        else out.push(A[i++].concat(B[j++]));
      }
      while(i<A.length) out.push(A[i++]);
      while(j<B.length) out.push(B[j++]);
      next.push(out);
    }
    lists=next;
  }
  return {done:true, tiers:lists[0]};
}
function label(tier){ return tier.map(id=>SONGS[id].t).join(' ＝ '); }
function groupOf(tier){ return [...new Set(tier.map(id=>SONGS[id].g))].join(' / '); }

/* ---------- バトル画面 ---------- */
function renderBattle(){
  const r=run(state.order, state.answers);
  if(r.done){ return renderResult(r.tiers); }
  show('battle');
  const n=state.order.length;
  const total=Math.max(1, Math.ceil(n*Math.log2(n)));
  const pct=Math.min(100, Math.round(state.answers.length/total*100));
  $('progBar').style.width=pct+'%';
  $('progText').textContent=state.answers.length+'回 / 約'+total+'回';
  const [A,B]=r.pair;
  $('pickA').innerHTML='<small></small><span></span>';
  $('pickB').innerHTML='<small></small><span></span>';
  $('pickA').firstChild.textContent=groupOf(A); $('pickA').lastChild.textContent=label(A);
  $('pickB').firstChild.textContent=groupOf(B); $('pickB').lastChild.textContent=label(B);
}
function answer(a){ state.answers.push(a); save(); renderBattle(); }
$('pickA').onclick=()=>answer(0);
$('pickB').onclick=()=>answer(1);
$('btnTie').onclick=()=>answer(2);
$('btnUndo').onclick=()=>{ if(state.answers.length){ state.answers.pop(); save(); renderBattle(); } };
$('btnQuit').onclick=()=>{ show('setup'); checkResume(); };

/* ---------- 結果画面 ---------- */
function renderResult(tiers){
  clearSave();
  const rows=[]; let rank=1;
  for(const t of tiers){
    if(rank>state.topN) break;
    rows.push({rank, tier:t});
    rank+=t.length;
  }
  const box=$('rankList'); box.innerHTML='';
  rows.forEach(r=>{
    const li=document.createElement('li');
    const no=document.createElement('div'); no.className='no'; no.textContent=r.rank;
    const tt=document.createElement('div'); tt.className='tt';
    tt.textContent=label(r.tier);
    const sm=document.createElement('small'); sm.textContent=groupOf(r.tier);
    tt.appendChild(sm);
    li.append(no,tt); box.appendChild(li);
  });
  $('resTitle').textContent='あなたの好きな曲TOP'+state.topN;
  const text='私の好きな曲TOP'+state.topN+'\n'+rows.map(r=>r.rank+'位 '+label(r.tier)).join('\n')+'\n#楽曲ソート';
  $('btnShare').href='https://twitter.com/intent/tweet?text='+encodeURIComponent(text)+'&url='+encodeURIComponent(location.href.split('#')[0]);
  show('result');
}
$('btnAgain').onclick=()=>{ show('setup'); checkResume(); };

/* ---------- 再開 ---------- */
function checkResume(){
  const s=load();
  const ok=s && Array.isArray(s.order) && s.order.every(id=>SONGS[id]);
  $('resume').classList.toggle('hidden', !ok);
}
$('btnResume').onclick=()=>{ state=load(); renderBattle(); };
$('btnDiscard').onclick=()=>{ clearSave(); checkResume(); };

renderAll();
checkResume();
</script>
</body>
</html>
